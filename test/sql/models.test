# name: test/sql/models.test
# description: do_models checks that need no network calls
# group: [docn]

require docn

# '' means "no key" and turns off the DO_MODEL_ACCESS_KEY fallback,
# so this check holds even when the environment variable is set.
statement ok
SET do_model_access_key = ''

statement error
FROM do_models()
----
no model access key

statement ok
SET do_model_access_key = 'fake-key-for-offline-tests'

# DESCRIBE binds the function but never calls the API
query II
SELECT column_name, column_type FROM (DESCRIBE FROM do_models())
----
name	VARCHAR
type	VARCHAR
description	VARCHAR
creator	VARCHAR
context_length	BIGINT
max_output_tokens	BIGINT
