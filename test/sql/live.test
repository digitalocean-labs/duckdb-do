# name: test/sql/live.test
# description: Functions against the live DigitalOcean API. Skipped unless
#              DO_MODEL_ACCESS_KEY is set. No SET: the key comes from the environment.
# group: [docn]

require docn

require-env DO_MODEL_ACCESS_KEY

# do_models

# Only check that Jev is listed: catalog labels such as type can change.
query I
SELECT count(*) FROM do_models() WHERE name = 'typesafe-jev-1.13.0'
----
1

# The catalog is public, so do_models also works without a key
statement ok
SET do_model_access_key = ''

query I
SELECT count(*) > 0 FROM do_models()
----
true

statement ok
RESET do_model_access_key

# do_decide

statement ok
CREATE TABLE tickets AS SELECT * FROM (VALUES
    (1, 'I was charged twice this month. Refund me or I am leaving.'),
    (2, 'My droplet will not boot after I resized it.'),
    (3, 'DNS for my domain stopped resolving, production is down!'),
    (4, NULL)) t(id, ticket)

query II
SELECT id, (do_decide(ticket, 'Is the customer threatening to leave?')::VARIANT).noul::DOUBLE > 0.5
FROM tickets ORDER BY id
----
1	true
2	false
3	false
4	NULL

query II
SELECT id, (do_decide(ticket, 'Which team should handle this?', 'choice',
    [{label: 'billing', description: 'Charges, invoices, refunds'},
     {label: 'droplets', description: 'VM creation, resize, boot'},
     {label: 'networking', description: 'DNS, load balancers, firewalls'}])::VARIANT).choice::VARCHAR
FROM tickets ORDER BY id
----
1	billing
2	droplets
3	networking
4	NULL

query II
SELECT id, (do_decide(ticket, 'How severe is this?', 'score', ['low', 'medium', 'high'])::VARIANT).label::VARCHAR
FROM tickets WHERE id = 3
----
3	high

query III
SELECT id, a.team.choice::VARCHAR, a.urgent.type::VARCHAR
FROM (SELECT id, do_decide(ticket, {
    team: {type: 'choice', instructions: 'Which team?', criteria: ['billing', 'droplets', 'networking']},
    urgent: {type: 'noul', instructions: 'Is this urgent?'}})::VARIANT AS a FROM tickets WHERE id = 2)
----
2	droplets	noul

# do_prompt: returns text from the default model and from an explicit model

query I
SELECT length(do_prompt('Reply with the single word: ok')) > 0
----
true

query I
SELECT length(do_prompt('Reply with the single word: ok', 'qwen3.8-max')) > 0
----
true

# do_embed: vector sizes depend on the model

query II
SELECT len(do_embed('hello')), len(do_embed('hello', 'all-mini-lm-l6-v2'))
----
1024	384

# Semantic search: the droplet ticket is closest to a phrase that shares no key words
query I
SELECT id FROM tickets WHERE ticket IS NOT NULL
ORDER BY list_cosine_similarity(do_embed(ticket), do_embed('my server will not start up')) DESC
LIMIT 1
----
2

# Batching: 600 rows with 300 distinct texts are all embedded
query II
SELECT count(*), count(v) FROM (SELECT do_embed('ticket ' || (i % 300)) AS v FROM range(600) r(i))
----
600	600
