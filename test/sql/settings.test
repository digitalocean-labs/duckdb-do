# name: test/sql/settings.test
# description: SET options registered by the docn extension
# group: [docn]

require docn

# The key is unset (NULL) by default, so the DO_MODEL_ACCESS_KEY environment variable is used
query III
SELECT (SELECT value IS NULL FROM duckdb_settings() WHERE name = 'do_model_access_key'), current_setting('do_decide_model'), current_setting('do_max_concurrent_requests')
----
true	typesafe-jev-1.13.0	32

statement ok
SET do_model_access_key = 'test-key'

statement ok
SET do_max_concurrent_requests = 8

query II
SELECT current_setting('do_model_access_key'), current_setting('do_max_concurrent_requests')
----
test-key	8

statement error
SET do_max_concurrent_requests = 'lots'
----
Could not convert string 'lots' to INT64

# RESET returns the key to unset, so the environment variable is used again
statement ok
RESET do_model_access_key

query I
SELECT value IS NULL FROM duckdb_settings() WHERE name = 'do_model_access_key'
----
true
