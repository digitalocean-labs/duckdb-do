# name: test/sql/embed.test
# description: do_embed checks that need no network calls
# group: [docn]

require docn

# '' means "no key" and turns off the DO_MODEL_ACCESS_KEY fallback
statement ok
SET do_model_access_key = ''

statement error
SELECT do_embed('hello')
----
no model access key

statement ok
SET do_model_access_key = 'fake-key-for-offline-tests'

# NULL texts return NULL without calling the API
query I
SELECT do_embed(NULL::VARCHAR)
----
NULL

query I
SELECT typeof(do_embed(NULL::VARCHAR))
----
FLOAT[]

statement error
SELECT do_embed('hello', m) FROM (VALUES ('qwen3-embedding-0.6b')) t(m)
----
argument 2 must be a constant, not a column
